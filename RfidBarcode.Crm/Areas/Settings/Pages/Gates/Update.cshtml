@page
@model RfidBarcode.Crm.Areas.Settings.Pages.Gates.UpdateModel
@{
    var action = (Model.ViewModel.Id == 0 ? "Tambah" : "Ubah");
    ViewData["Title"] = action + " Gate";
}

@section Scripts {
    <script>
        SimplePageForm.Init($('@Html.AntiForgeryToken()').val(), '/Settings/Gates/Update');
        SimplePageForm.Select2('prevLocationId', 'Pilih Lokasi Sebelumnya', 'Location', '#modal');
        SimplePageForm.Select2('nextLocationId', 'Pilih Lokasi Berikutnya', 'Location', '#modal');

        SimplePageTable.Init($('@Html.AntiForgeryToken()').val(), '/Settings/Gates/Update');
        SimplePageTable.InitTable({
            hasAction: true,
            hasEdit: true,
            hasDelete: true,
            action: 'popup',
            columns: [
                { data: 'antenna', name: 'Antenna' },
                { data: 'prevLocationName', name: 'PrevLocationName' },
                { data: 'nextLocationName', name: 'NextLocationName' },
            ],
        });

       

    </script>
    @if (Model.ViewModel.Id  > 0)
    {
        <script>
            $('#modal').on('shown.bs.modal', function () {
                $('#gateId').val('@Model.ViewModel.Id')
            });
        </script>
    }
}


<!-- #region Content -->
<div class="row">
    <div class="col-12">
        <form method="post">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex flex-sm-row flex-column justify-content-between">
                        <div class="me-auto">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                                    <li class="breadcrumb-item"><a href="/Settings/Gates/">Gates</a></li>
                                    <li class="breadcrumb-item active" aria-current="Page">@action</li>
                                </ol>
                            </nav>

                            <h3 class="pt-3">@ViewData["Title"]</h3>
                        </div>
                        <div class="align-self-end">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-save"></i> Save
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <input type="hidden" asp-for="@Model.ViewModel.Id" />
                    <div class="row">
                        <div class="form-group mb-3 col-sm-12 col-md-6">
                            <label class="form-label" asp-for="@Model.ViewModel.Name">Nama Gate</label>
                            <input type="text" class="form-control" asp-for="@Model.ViewModel.Name" />
                        </div>
                        <div class="form-group mb-3 col-sm-12 col-md-6">
                            <label class="form-label" asp-for="@Model.ViewModel.ClientId">Client Id (MQTT Topic)</label>
                            <input type="text" class="form-control" asp-for="@Model.ViewModel.ClientId" />
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- #endregion -->

<!-- #region GateMap -->
@if (Model.ViewModel.Id > 0)
{
    <div class="row mt-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-start">
                        <div class="me-auto">
                            <h3>Gate Map</h3>
                        </div>
                        <div class="align-bottom">
                            <button class="btn btn-primary" type="button" onclick="SimplePageTable.Open('-1')">
                                <i class="fas fa-plus"></i> Tambah
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <table id="grid" class="bg-white table table-sm fs--1 mb-0 w-100" width="100%">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Antena</th>
                                <th>Lokasi Sebelum</th>
                                <th>Lokasi Setelah</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="modal" aria-labelledby="entryModalLabel" aria-hidden="true">
        <form id="entryForm" method="POST">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="entryModalLabel">Entry Gate Map</h5>
                        <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
                            <span class="fas fa-times fs--1"></span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" class="modal-input" id="gateId" name="gateId" value="@Model.ViewModel.Id" />
                        <input type="hidden" class="modal-input" id="id" name="id" />
                        <div class="form-group mb-3">
                            <label class="form-label" for="antenna">Antena *</label>
                            <input type="text" class="form-control modal-input" id="antenna" name="antenna" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label" for="prevLocationId">Lokasi Sebelumnya</label>
                            <select class="form-select modal-input" id="prevLocationId" name="prevLocationId" data-select2-label="prevLocationName">
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label" for="nextLocationId">Lokasi Setelahnya *</label>
                            <select class="form-select modal-input" id="nextLocationId" name="nextLocationId" data-select2-label="nextLocationName" required> 
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-primary" type="button" onclick="SimplePageTable.Save()">Save</button>
                        <button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
}
<!-- #endregion -->