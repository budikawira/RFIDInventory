@page
@model RfidBarcode.Crm.Areas.Settings.Pages.PasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row">
    <div class="col-12">
        <form method="post">
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-end">
                        <div class="col-md-10">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                                    <li class="breadcrumb-item active" aria-current="Page">Change Password</li>
                                </ol>
                            </nav>

                            <h3 class="w-75 p-3">@ViewData["Title"]</h3>
                        </div>
                        <div class="col-md-2 p-3 text-end align-bottom">
                            <button class="btn btn-primary" type="submit">
                                <i class="fas fa-save"></i> Save
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="form-group row align-items-center mb-3">
                            <label class="form-label col-sm-12 col-md-3 text-sm-start text-md-end" asp-for="CurrentPassword">Password Saat Ini</label>
                            <div class="col-sm-12 col-md-9">
                                <input type="password" asp-for="CurrentPassword" class="form-control" required />
                            </div>
                        </div>
                        <div class="form-group row align-items-center mb-3">
                            <label class="form-label col-sm-12 col-md-3 text-sm-start text-md-end" asp-for="NewPassword">Password Baru</label>
                            <div class="col-sm-12 col-md-9">
                                <input type="password" asp-for="NewPassword" class="form-control" required />
                            </div>
                        </div>
                        <div class="form-group row align-items-center mb-3">
                            <label class="form-label col-sm-12 col-md-3 text-sm-start text-md-end" asp-for="NewPassword">Konfirmasi Password Baru</label>
                            <div class="col-sm-12 col-md-9">
                                <input type="password" asp-for="ConfirmPassword" class="form-control" required />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>