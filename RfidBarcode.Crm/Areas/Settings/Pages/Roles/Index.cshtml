@page
@model RfidBarcode.Crm.Areas.Settings.Pages.Roles.IndexModel
@{
    ViewData["Title"] = "Manajemen Role";
}

@section Styles {
    <style>
        table.dataTable tbody tr.selected {
            background-color: red !important;
        }

    </style>
}

@section Scripts {
    <script>
        let jsFunction = (() => {
            var _url;
            var _token;
            var _grid;
            var _gridModal;
            var _roleId;

            return {
                SetRoleId: ((roleId) => {
                    $('#cardAcc').show();
                    _roleId = roleId;
                    _grid.ajax.reload();
                }),
                Init: ((token, url) => {
                    _token = token;
                    _url = url;
                    _grid = $('#gridAccess').DataTable({
                        processing: true,
                        serverSide: true,
                        orderCellsTop: true,
                        autoWidth: true,
                        scrollX: true,
                        dom: '<"top d-flex flex-sm-row flex-column justify-content-between"<"ms-0 m-1"l>f>tr<"bottom"ip>',
                        ajax: {
                            url: _url + '?Handler=AccRefreshData',
                            type: 'POST',
                            headers: { 'RequestVerificationToken': _token },
                            data: function (d) {
                                d.roleId = _roleId;
                            }
                        },
                        pagingType: $(window).width() < 768 ? "numbers" : "simple_numbers",
                        lengthMenu: [[10, 25, 50, 100, 500, 1000], [10, 25, 50, 100, 500, 1000]],
                        columnDefs: [
                            { className: "align-middle", targets: "_all" },
                            { orderable: false, targets: [0]}
                        ],
                        order: [[1, 'asc']],
                        columns: [
                            { data: null, render: function(data,type,row,node) {
                                var button = `<span class="text-nowrap d-inline-block">`;
                                button += `<button rel="tooltip" type="button" data-bs-placement="top" data-container="body" title="Delete" class="btn btn-sm btn-soft-danger me-1 mb-1" onclick="jsFunction.Delete('` + node.row + `') ">`;
                                button += '<i class="far fa-trash-alt"> </i></button>';
                                return button;
                            }},
                            { data: 'description', name: 'Description' },
                        ]
                    });


                    $(".checkbox-input-all").change(function() {
                        $(".checkbox-input").prop('checked', $(this).prop("checked"));
                    });
                }),
                Delete: ((row) => {
                    _row = row || -1;
                    var rowData = _grid.row(_row).data();
                    console.log('rowData >> ', rowData);
                    Swal.fire({
                        title: 'Are you sure to delete this data?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            LoadingScreenFunction.Show();
                            $.ajax({
                                type: "POST",
                                url: _url + "?Handler=AccDelete",
                                headers: { 'RequestVerificationToken': _token },
                                data: {
                                    id: rowData.id
                                },
                                success: function (objRes) {
                                    LoadingScreenFunction.Hide();
                                    if (objRes.result != 0) {
                                        Swal.fire(objRes.message, '', 'error')
                                    } else {
                                        Swal.fire({
                                            title: 'Deleted!',
                                            text: 'Your data has been deleted.',
                                            icon: 'success',
                                            timer: 3000,
                                            timerProgressBar: true
                                        });
                                        _grid.ajax.reload(null, false);
                                    }
                                },
                                error: function (response) {
                                    LoadingScreenFunction.Hide();
                                    alert('Error function please contact developer');
                                }
                            })
                        }
                    })
                }),
                Open: (() => {
                    $('#modalAcc').modal('show');

                    if (_gridModal == null) {
                        _gridModal = $('#gridModal').DataTable({
                            processing: true,
                            serverSide: true,
                            orderCellsTop: true,
                            autoWidth: true,
                            scrollX: true,
                            dom: '<"top d-flex flex-sm-row flex-column justify-content-between"<"ms-0 m-1"l>f>tr<"bottom"ip>',
                            ajax: {
                                url: _url + '?Handler=ModalRefreshData',
                                type: 'POST',
                                headers: { 'RequestVerificationToken': _token },
                                data: function (d) {
                                    d.excludedRoleId = _roleId;
                                }
                            },
                            pagingType: $(window).width() < 768 ? "numbers" : "simple_numbers",
                            lengthMenu: [[10, 25, 50, 100, 500, 1000], [10, 25, 50, 100, 500, 1000]],
                            columnDefs: [
                                { className: "align-middle", targets: "_all" },
                                { orderable: false, targets: [0]}
                            ],
                            initComplete: function (settings, json) {
                                setTimeout(function () {
                                    _gridModal.columns.adjust().draw();
                                }, 100);
                            },
                            order: [[1, 'asc']],
                            columns: [
                                { data: null, render: function(data,type,row,node) {
                                    return `<input class="form-check-input checkbox-input ms-3" type="checkbox" value="${data['id']}" id="cbInput">`;
                                }},
                                { data: 'description', name: 'Description' },
                            ]
                        });
                    } else {
                        _gridModal.ajax.reload();
                    }
                }),
                AddItems: (() => {
                    var accIds = [];
                    $(".checkbox-input:checked").each(function() {
                        accIds.push($(this).val());
                    });

                    LoadingScreenFunction.Show();

                    var dataParam = {
                        accIds: accIds,
                        roleId: _roleId
                    };

                    $.ajax({
                        type: "POST",
                        url: _url + "?Handler=AddAccItems",
                        data: dataParam,
                        headers: {
                            'RequestVerificationToken': _token
                        },
                        success: function(objRes) {
                            LoadingScreenFunction.Hide();
                            $('#modalAcc').modal('hide');
                            _grid.ajax.reload();
                        },
                        error: function(response) {
                            console.log('response err >> ', response);
                            LoadingScreenFunction.Hide();
                            Swal.fire('Error : ' + response.status, response.responseText, 'error');
                        }
                    });
                })
            }
        })();
    </script>
    <script>
        jsFunction.Init($('@Html.AntiForgeryToken()').val(), '/Settings/Roles');
        SimplePageTable.Init($('@Html.AntiForgeryToken()').val(), '/Settings/Roles');
        SimplePageTable.InitTable({
            hasAction: true,
            hasEdit: true,
            hasDelete: true,
            action: 'popup',
            columnDefs: [
                { orderable: false, targets: [0]}
            ],
            columns: [
                { data: 'name', name: 'Name' },
            ]
        });
    </script>
    <script>

        $('#grid tbody').on('click', 'tr', function () {
            if (!$(this).hasClass('selected')) {
                SimplePageTable.GetTable().$('tr.selected').removeClass('selected');
                $(this).addClass('selected');
                let selectedData = SimplePageTable.GetTable().rows('.selected').data()[0] || {};
                console.log('selected data >> ', selectedData);
                jsFunction.SetRoleId(selectedData['id']);
                //gridMenuItem.ajax.reload();
            }
        });
    </script>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item active" aria-current="Page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="row">
    <div class="col-sm-12 col-md-6 mb-3">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between">
                    <div class="p-3">
                        <h3>Roles</h3>
                    </div>
                    <div class="p-3 text-end align-bottom">
                        <button class="btn btn-primary" type="button" onclick="SimplePageTable.Open('-1')">
                            <i class="fas fa-plus"></i> Add
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <table id="grid" class="bg-white table table-sm fs--1 mb-0 w-100" width="100%">
                    <thead>
                        <tr>
                            <th data-role="action" style="width:1%">Action</th>
                            <th class="sort" data-role="text">Role</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-md-6 mb-3">
        <div class="card" style="display:none;" id="cardAcc">
            <div class="card-header">
                <div class="d-flex justify-content-between">
                    <div class="p-3">
                        <h3>Access</h3>
                    </div>
                    <div class="p-3 text-end align-bottom">
                        <button class="btn btn-primary" type="button" onclick="jsFunction.Open()">
                            <i class="fas fa-plus"></i> Add
                        </button>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <table id="gridAccess" class="bg-white table table-sm fs--1 mb-0 w-100" width="100%">
                    <thead>
                        <tr>
                            <th data-role="action" style="width:1%">Action</th>
                            <th class="sort" data-role="text">Deskripsi Akses</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modal" tabindex="-1" aria-labelledby="entryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle"></h5>
                <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
                    <span class="fas fa-times fs--1"></span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" class="modal-input" id="id" name="id" />
                <div class="form-group mb-3">
                    <label class="form-label" for="name">Role</label>
                    <input class="form-control modal-input" id="name" name="name" type="text" maxlength="50" required />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" type="button" onclick="SimplePageTable.Save()">Save</button>
                <button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAcc" tabindex="-1" aria-labelledby="entryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Tambah</h5>
                <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
                    <span class="fas fa-times fs--1"></span>
                </button>
            </div>
            <div class="modal-body">
                <table id="gridModal" class="bg-white table table-sm fs--1 mb-0 w-100" width="100%">
                    <thead>
                        <tr>
                            <th style="width:1%;"><input class="form-check-input checkbox-input-all ms-3 me-3" type="checkbox" id="cbInputAll"></th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary me-2" type="button" onclick="jsFunction.AddItems()">Tambah</button>
                    <button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
