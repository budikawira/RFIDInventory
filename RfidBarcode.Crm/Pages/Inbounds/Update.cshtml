                width: 100%;
            }

            .table-borderless th,
            .table-borderless td {
                border: none;
                padding: 6px;
                text-align: left;
            }
        </style>
        <table class="table-borderless">
            <tbody>
                <tr>
                    <td style="width:120px;text-align:left"><strong>No Surat Jalan</strong></td>
                    <td style="text-align:left"><strong>: @Model.ViewModel.No</strong></td>
                    <td style="text-align:right;"><strong>KA : @Model.ViewModel.Kode</strong></td>
                </tr>
                <tr>
                    <td style="vertical-align:top;text-align:left;width:150px"><strong>User</strong></td>
                    <td style="vertical-align:top;text-align:left"><strong>: @Model.Username</strong></td>
                    <td style="text-align:right" rowspan="2"><image src="/api/qr?text=@Model.ViewModel.No" style="width:80px;height:80px" /></td>
                </tr>
                <tr><td colspan="2" style="vertical-align:bottom;text-align:left"><strong>@Model.ViewModel.Grade</strong></td></tr>
            </tbody>
        </table>
        <br />
        <table class="table-bordered">
            <thead>
                <tr>
                    <th width="20%"><strong>PO : @(Model.ColKp.Count > 0 ? Model.ColKp[0] : "")</strong></th>
                    <th width="20%"><strong>PO : @(Model.ColKp.Count > 1 ? Model.ColKp[1] : "")</strong></th>
                    <th width="20%"><strong>PO : @(Model.ColKp.Count > 2 ? Model.ColKp[2] : "")</strong></th>
                    <th width="20%"><strong>PO : @(Model.ColKp.Count > 3 ? Model.ColKp[3] : "")</strong></th>
                    <th width="20%"><strong>PO : @(Model.ColKp.Count > 4 ? Model.ColKp[4] : "")</strong></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < 5; i++)
                {
                    <tr>
                        <td><div class="cell-wrapper">@Model.ColItems[0].ElementAt(i)</div></td>
                        <td>@Model.ColItems[1].ElementAt(i)</td>
                        <td>@Model.ColItems[2].ElementAt(i)</td>
                        <td>@Model.ColItems[3].ElementAt(i)</td>
                        <td>@Model.ColItems[4].ElementAt(i)</td>
                    </tr>
                }
                <tr>
                    <td style="text-align:center;"><strong>@(Model.ColYards[0] > 0 ? Model.ColYards[0].ToString() : "")</strong></td>
                    <td style="text-align:center;"><strong>@(Model.ColYards[1] > 0 ? Model.ColYards[1].ToString() : "")</strong></td>
                    <td style="text-align:center;"><strong>@(Model.ColYards[2] > 0 ? Model.ColYards[2].ToString() : "")</strong></td>
                    <td style="text-align:center;"><strong>@(Model.ColYards[3] > 0 ? Model.ColYards[3].ToString() : "")</strong></td>
                    <td style="text-align:center;"><strong>@(Model.ColYards[4] > 0 ? Model.ColYards[4].ToString() : "")</strong></td>
                </tr>
            </tbody>
        </table>
        <br />
        <table style="border:none">
            <tbody>
                <tr style="border:none">
                    <td style="border:none;"><strong>TOTAL ROLL : @Model.TotalRoll</strong></td>
                    <td style="border:none;text-align:right;"><strong>TOTAL YARD: @Model.TotalYard YDS</strong></td>
                </tr>
                <tr style="border:none">
                    <td style="border:none;"><strong>PERHATIAN SJ!</strong></td>
                    <td style="border:none;text-align:right;"><strong>PERHATIAN BRG!</strong></td>
                </tr>
            </tbody>
        </table>
    </div>

}