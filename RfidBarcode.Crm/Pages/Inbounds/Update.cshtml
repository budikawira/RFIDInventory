@page
@model RfidBarcode.Crm.Pages.Inbounds.UpdateModel
@{
    ViewData["Title"] = "Ubah Surat Jalan"; 
}

@section Scripts
{
    <script>
            let jsFunction = (() => {
                var _gridModal;
                var _token;
                var _url;
            return {
                Init: ((token, url) => {
                    _token = token;
                    _url = url;
                }),

                Open: (() => {
                    jsFunction.RefreshTable();
                    $('#modal').modal('show');
                }),

                OpenFinalize: (() => {
                    $('#modalFinalize').modal('show');
                }),
                Unfinalize: (() => {
                     Swal.fire({
                        title: 'Batalkan Finalisasi Surat Jalan?',
                        icon: 'success',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Ya, Batalkan!',
                        cancelButtonText: 'Selesai'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            LoadingScreenFunction.Show();

                            $.ajax({
                                type: "POST",
                                url: "/Inbounds/Update?Handler=Unfinalize",
                                data: {
                                    suratJalanId: $('#suratJalanId').val()
                                },
                                headers: {
                                    'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                                },
                                success: function(objRes) {
                                    console.log('objRes >> ', objRes);
                                    LoadingScreenFunction.Hide();

                                    if (objRes.result == 0) {
                                        window.location.reload();
                                    } else {
                                        Swal.fire('Gagal Finalisasi!', objRes.message, 'error');
                                    }
                                },
                                error: function(response) {
                                    console.log('response err >> ', response);
                                    LoadingScreenFunction.Hide();
                                    Swal.fire('Error : ' + response.status, response.responseText, 'error');
                                }
                            });
                        }
                    });
                }),
                Finalize: (() => {
                    var isValid = 0;
                    isValid += validateBlank('no');

                    if (isValid > 0) {
                        Swal.fire('Fail', 'Please input all mandatory data', 'error');
                        return;
                    }

                    Swal.fire({
                        title: 'Finalisasi Surat Jalan?',
                        text: "Data tidak dapat diubah lagi!",
                        icon: 'success',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Ya, Finalisasi!',
                        cancelButtonText: 'Selesai'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            LoadingScreenFunction.Show();

                            $.ajax({
                                type: "POST",
                                url: "/Inbounds/Update?Handler=Finalize",
                                data: {
                                    suratJalanId: $('#suratJalanId').val(),
                                    type: $('#type').val(),
                                    no: $('#no').val(),
                                    sequence: $('#sequence').val()
                                },
                                headers: {
                                    'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                                },
                                success: function(objRes) {
                                    console.log('objRes >> ', objRes);
                                    LoadingScreenFunction.Hide();

                                    if (objRes.result == 0) {
                                        window.location.reload();
                                    } else {
                                        Swal.fire('Gagal Finalisasi!', objRes.message, 'error');
                                    }
                                },
                                error: function(response) {
                                    console.log('response err >> ', response);
                                    LoadingScreenFunction.Hide();
                                    Swal.fire('Error : ' + response.status, response.responseText, 'error');
                                }
                            });
                        }
                    });
                }),
                Confirm: (() => {
                     Swal.fire({
                        title: 'Konfirmasi Penerimaan?',
                        text: "Data tidak dapat diubah lagi!",
                        icon: 'success',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Ya, Konfirmasi!',
                        cancelButtonText: 'Selesai'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            LoadingScreenFunction.Show();

                            $.ajax({
                                type: "POST",
                                url: "/Inbounds/Update?Handler=Confirm",
                                data: {
                                    suratJalanId: $('#suratJalanId').val()
                                },
                                headers: {
                                    'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                                },
                                success: function(objRes) {
                                    console.log('objRes >> ', objRes);
                                    LoadingScreenFunction.Hide();

                                    if (objRes.result == 0) {
                                        window.location.reload();
                                    } else {
                                        Swal.fire('Gagal Konfirmasi!', objRes.message, 'error');
                                    }
                                },
                                error: function(response) {
                                    console.log('response err >> ', response);
                                    LoadingScreenFunction.Hide();
                                    Swal.fire('Error : ' + response.status, response.responseText, 'error');
                                }
                            });
                        }
                    });
                }),
                AddItems: (() => {
                    var itemIds = [];
                    $(".checkbox-input:checked").each(function() {
                        itemIds.push($(this).val());
                    });

                    LoadingScreenFunction.Show();

                    var dataParam = {
                        itemIds: itemIds,
                        suratJalanId: $('#suratJalanId').val()
                    };

                    $.ajax({
                        type: "POST",
                        url: "/Inbounds/Update?Handler=AddItems",
                        data: dataParam,
                        headers: {
                            'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                        },
                        success: function(objRes) {
                            LoadingScreenFunction.Hide();
                            $('#modal').modal('hide');
                            SimplePageTable.GetTable().ajax.reload();
                        },
                        error: function(response) {
                            console.log('response err >> ', response);
                            LoadingScreenFunction.Hide();
                            Swal.fire('Error : ' + response.status, response.responseText, 'error');
                        }
                    });
                }),
                RefreshTable: (() => {
                    if (_gridModal == null) {
                        _gridModal = $('#gridModal').DataTable({
                            processing: true,
                            serverSide: true,
                            orderCellsTop: true,
                            autoWidth: true,
                            scrollX: true,
                            ajax: {
                                url: _url + '?Handler=RefreshDataModal',
                                type: 'POST',
                                headers: {
                                    'RequestVerificationToken': _token
                                },
                                data: function(d) {
                                    d.suratJalanId = $('#suratJalanId').val();
                                }
                            },
                            columns: [
                                {
                                    data: null,
                                    render: function(data, type, row, node) {
                                        return `<input class="form-check-input checkbox-input ms-3" type="checkbox" value="${data['id']}" id="cbInput" checked>`;
                                    }
                                },
                                { data: 'createdDateString', name: 'CreatedDate' },
                                { data: 'locationName', name: 'LocationName' },
                                { data: 'id', name: 'Id' },
                                { data: 'merk', name: 'Merk' },
                                { data: 'kp', name: 'Kp' },
                                { data: 'kode1', name: 'Kode1' },
                                { data: 'kode2', name: 'Kode2' },
                                { data: 'kode3', name: 'Kode3' },
                                { data: 'kode4', name: 'Kode4' },
                                { data: 'oz', name: 'Oz' },
                                { data: 'grade', name: 'Grade' },
                                { data: 'point', name: 'Point' },
                                { data: 'yard', name: 'Yard' },
                                { data: 'kg', name: 'Kg' },
                                { data: 'lebar', name: 'Lebar' },
                                { data: 'k', name: 'K' },
                                { data: 'susutLusi', name: 'SusutLusi' },
                                { data: 'serialNumber', name: 'SerialNumber' },
                                { data: 'k3l', name: 'K3l' },
                                { data: 'inisial', name: 'Inisial' },
                                { data: 'tanggalBuatBarcodeString', name: 'TanggalBuatBarcode' }
                            ],
                            order: [[1, "asc"]],
                            columnDefs: [{
                                orderable: false,
                                targets: 0
                            }],
                            pageLength: 25
                        });
                    } else {
                        _gridModal.ajax.reload(null, false);
                    }
                })
            }
        })();
    </script>
    <script>
        var hasDelete = @(Model.ViewModel.FinalizeDate == null ? "true" : "false");
        SimplePageTable.Init($('@Html.AntiForgeryToken()').val(), '/Inbounds/Update');
        SimplePageTable.InitTable({
        hasAction: hasDelete,
        hasDelete: hasDelete,
        action: 'page',
        columns: [
        { data: 'createdDateString', name: 'CreatedDate' },
        { data: 'locationName', name: 'LocationName' },
        { data: 'id', name: 'Id' },
        { data: 'merk', name: 'Merk' },
        { data: 'kp', name: 'Kp' },
        { data: 'kode1', name: 'Kode1' },
        { data: 'kode2', name: 'Kode2' },
        { data: 'kode3', name: 'Kode3' },
        { data: 'kode4', name: 'Kode4' },
        { data: 'oz', name: 'Oz' },
        { data: 'grade', name: 'Grade' },
        { data: 'point', name: 'Point' },
        { data: 'yard', name: 'Yard' },
        { data: 'kg', name: 'Kg' },
        { data: 'lebar', name: 'Lebar' },
        { data: 'k', name: 'K' },
        { data: 'susutLusi', name: 'SusutLusi' },
        { data: 'serialNumber', name: 'SerialNumber' },
        { data: 'k3l', name: 'K3l' },
        { data: 'inisial', name: 'Inisial' },
        { data: 'tanggalBuatBarcodeString', name: 'TanggalBuatBarcode' },
        ],
        columnDefs: [
        { targets: [1], sortable: false }
        ],
        order: [[3,'desc']]
        });

        jsFunction.Init($('@Html.AntiForgeryToken()').val(), '/Inbounds/Update');


        let seqPrefix;

        $(document).ready(function () {
            $(".checkbox-input-all").change(function () {
                $(".checkbox-input").prop('checked', $(this).prop("checked"));
            });

            $('#type').change(function () {
                var selectedValue = $('#type').val();
                $('#noPrefixLabel').text(selectedValue + '/');

                var no = $('#no').val();
                if (no.length >= 2) {
                    refreshSequenceNo();
                }
            });

            $('#no').on('input', function() {
                var no = $('#no').val();
                if (no.length >= 2) {
                    var newSeqPrefix = no.substring(0, 2);
                    if (seqPrefix != newSeqPrefix) {
                        seqPrefix = newSeqPrefix;
                        refreshSequenceNo();
                    }
                    if (no.length == 4) {
                        $('#btnFinalize').removeAttr('disabled');
                    } else {
                        $('#btnFinalize').attr('disabled',true);
                    }
                } else {
                    seqPrefix = '';
                    $('#btnFinalize').attr('disabled',true);
                    $('#noPostfixLoading').hide();
                    $('#noPostfixLabel').text('/00001');
                    $('#sequence').val('1');
                }
            });
        });

        function refreshSequenceNo() {
            $('#noPostfixLoading').show();
            $('#noPostfixLabel').text('');
            $.ajax({
                type: "POST",
                url: "/Inbounds/Update?Handler=GetNoSequence",
                data: {
                    type: $('#type').val(),
                    seqPrefix: seqPrefix
                },
                headers: {
                    'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                },
                success: function(objRes) {
                    if (objRes.result == 0) {
                        var no = objRes.data;
                        $('#sequence').val(no);
                        var padded = no.toString().padStart(5,'0');
                        $('#noPostfixLabel').text('/' + padded);
                        $('#noPostfixLoading').hide();
                    }
                },
                error: function(response) {

                }
            })
        }
    </script>
    <script>
        function openAndPrint() {
            // Open a new window
            const printWindow = window.open('', '', 'width=800,height=600');

            // Get the content from the print section
            const content = document.getElementById('print-section').innerHTML;

            // Write content to the new window
            printWindow.document.write('<html><head><title>Invoice</title>');
            printWindow.document.write('<style>body{font-family: Arial, sans-serif;} table{width: 100%; border-collapse: collapse;} th, td{border: 0px solid #ddd; padding: 8px; text-align:center} th{background-color: #f4f4f4;} .cell-wrapper{min-height:20px;display:flex;align-items:center;box-sizing:border-box}</style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(content);

            // Wait for the window to load, then trigger print dialog
            printWindow.document.close();
            printWindow.onload = function() {
                printWindow.print();
                printWindow.close(); // Optionally close the window after printing
            };
        }

    </script>
}

@section Styles
{
    <style>
        /* Hide print section in the browser */
        #print-section {
            display: none;
        }

        @@media print {
            @@page {
                size: landscape;
            }

            body * {
                visibility: hidden;
            }

            #print-section, #print-section * {
                visibility: visible;
            }
        }

        .invoice-box {
            max-width: 600px;
            margin: auto;
            padding: 30px;
            font-family: 'Arial', sans-serif;
            border: 1px solid #eee;
            font-size: 14px;
        }

            .invoice-box table {
                width: 100%;
                border-collapse: collapse;
            }

            .invoice-box th, .invoice-box td {
                border: 1px solid #ddd;
                padding: 8px;
            }

            .invoice-box th {
                background-color: #f4f4f4;
            }

    </style>

}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex flex-sm-row flex-column justify-content-between">
                    <div class="me-auto">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item"><a href="/Inbounds/">Surat Jalan</a></li>
                                <li class="breadcrumb-item active" aria-current="Page">Ubah</li>
                            </ol>
                        </nav>

                        <h3 class="pt-3">@ViewData["Title"]</h3>
                        @if (!string.IsNullOrEmpty(Model.ViewModel.No))
                        {
                            <h5>Nomor Surat Jalan : <strong>@Model.ViewModel.No</strong></h5>
                        }
                        else
                        {
                            
                        }
                    </div>
                    <div class="align-self-end">
                        @if (Model.ViewModel.FinalizeDate == null)
                        {
                            <button class="btn btn-primary" onclick="jsFunction.Open()">
                                <i class="fas fa-plus me-1"></i> Tambah
                            </button>
                            @if (string.IsNullOrEmpty(Model.ViewModel.No))
                            {
                                <button type="button" class="btn btn-success" onclick="jsFunction.OpenFinalize()">
                                    <i class="fas fa-check me-1"></i>  Finalisasi
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-success" onclick="jsFunction.Finalize()">
                                    <i class="fas fa-check me-1"></i>  Finalisasi
                                </button>
                            }
                        }
                        else if (Model.ViewModel.ConfirmDate == null)
                        {
                            <button type="button" class="btn btn-warning" onclick="jsFunction.Unfinalize()">
                                <i class="fas fa-cross me-1"></i>  Batalkan Finalisasi
                            </button>
                            <button class="btn btn-primary" onclick="openAndPrint()">
                                <i class="fas fa-print me-1"></i>  Print Surat Jalan
                            </button>
                            <button type="button" class="btn btn-success" onclick="jsFunction.Confirm()">
                                <i class="fas fa-check me-1"></i>  Konfirmasi Penerimaan
                            </button>
                        }

                    </div>
                </div>
            </div>

            <div class="card-body">
                <input type="hidden" id="suratJalanId" value="@Model.ViewModel.Id" class="grid-param" />
                <table id="grid" class="bg-white table table-sm fs--1 mb-0 w-100" width="100%">
                    <thead>
                        <tr>
                            @if (Model.ViewModel.FinalizeDate == null)
                            {
                                <th>Action</th>
                            }
                            <th>Tanggal Pembuatan</th>
                            <th>Lokasi</th>
                            <th>Tag Id</th>
                            <th>Merk</th>
                            <th>KP</th>
                            <th>Kode 1</th>
                            <th>Kode 2</th>
                            <th>Kode 3</th>
                            <th>Kode 4</th>
                            <th>OZ</th>
                            <th>Grade</th>
                            <th>Point</th>
                            <th>Yard</th>
                            <th>KG</th>
                            <th>Lebar</th>
                            <th>K</th>
                            <th>Susut Lusi</th>
                            <th>Serial Number</th>
                            <th>K3L</th>
                            <th>Inisial</th>
                            <th>Tanggal Buat Barcode</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modal" tabindex="-1" aria-labelledby="entryModalLabel" aria-hidden="true">
    <form id="entryForm" method="POST">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Tambah</h5>
                    <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
                        <span class="fas fa-times fs--1"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <table id="gridModal" class="bg-white table table-sm fs--1 mb-0 w-100" width="100%">
                        <thead>
                            <tr>
                                <th class="me-1"><input class="form-check-input checkbox-input-all ms-3" type="checkbox" id="cbInputAll" checked></th>
                                <th>Tanggal Pembuatan</th>
                                <th>Lokasi</th>
                                <th>Tag Id</th>
                                <th>Merk</th>
                                <th>KP</th>
                                <th>Kode 1</th>
                                <th>Kode 2</th>
                                <th>Kode 3</th>
                                <th>Kode 4</th>
                                <th>OZ</th>
                                <th>Grade</th>
                                <th>Point</th>
                                <th>Yard</th>
                                <th>KG</th>
                                <th>Lebar</th>
                                <th>K</th>
                                <th>Susut Lusi</th>
                                <th>Serial Number</th>
                                <th>K3L</th>
                                <th>Inisial</th>
                                <th>Tanggal Buat Barcode</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" type="button" onclick="jsFunction.AddItems()">Tambah</button>
                    <button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="modalFinalize" tabindex="-1" aria-labelledby="entryModalLabel" aria-hidden="true">
    <form id="entryForm" method="POST">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"></h5>
                    <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
                        <span class="fas fa-times fs--1"></span>
                    </button>
                </div>
                <div class="modal-body">

                    <div class="form-group mb-3">
                        <label class="form-label" for="name">Tipe Surat Jalan</label>
                        <select class="form-select modal-input" id="type" name="type">
                            @foreach (var item in Model.SuratJalanTypes)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label" for="no">Nomor Surat Jalan</label>
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="noPrefixLabel">@(Model.SuratJalanTypes.Count > 0 ? Model.SuratJalanTypes[0] : "")/</span>
                            <input class="form-control modal-input" id="no" name="no" type="text" style="max-width:100px" placeholder="cth: OL01" maxlength="4" value="@Model.ViewModel.GetNoCode()" />
                            <span class="input-group-text d-flex justify-content-center align-items-center" style="width:100px">
                                <span id="noPostfixLabel">/00001</span>
                                <div class="spinner-grow spinner-grow-sm text-secondary" role="status" style="display:none" id="noPostfixLoading">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </span>

                            <input type="hidden" class="modal-input" id="sequence" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnFinalize" disabled class="btn btn-primary" type="button" onclick="jsFunction.Finalize()">Finalisasi</button>
                    <button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </form>
</div>

