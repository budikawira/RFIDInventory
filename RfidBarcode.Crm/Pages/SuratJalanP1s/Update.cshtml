@page
@using RfidBarcode.Application.Common.Interfaces
@using RfidBarcode.Domain.Entities
@model RfidBarcode.Crm.Pages.SuratJalanP1s.UpdateModel

@inject IUserResolverService _user
@{
    ViewData["Title"] = Model.ViewModel.No;

    var HasConfirmAccess = ((!Model.ViewModel.IsReturn && _user.HasReadAccess(AccessMenu.ConfirmOutbond)) ||
                                Model.ViewModel.IsReturn && _user.HasReadAccess(AccessMenu.ConfirmOutbondReturn));

    var noString = string.IsNullOrEmpty(Model.ViewModel.No) ? "" : Model.ViewModel.No;
}

@section Scripts
{
    <script>
        let jsFunction = (() => {
            var _gridModal;
            var _token;
            var _url;
        return {
            Init: ((token, url) => {
                _token = token;
                _url = url;
            }),

            Open: (() => {
                jsFunction.RefreshTable();
                $('#modal').modal('show');
            }),

            OpenFinalize: (() => {
                $('#modalFinalize').modal('show');
            }),
            Unfinalize: (() => {
                Swal.fire({
                        title: 'Batalkan Finalisasi Surat Jalan?',
                        icon: 'success',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Ya, Batalkan!',
                        cancelButtonText: 'Selesai'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            LoadingScreenFunction.Show();

                            $.ajax({
                                type: "POST",
                                url: "/SuratJalanP1s/Update?Handler=Unfinalize",
                                data: {
                                    suratJalanP1Id: $('#suratJalanP1Id').val()
                                },
                                headers: {
                                    'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                                },
                                success: function(objRes) {
                                    console.log('objRes >> ', objRes);
                                    LoadingScreenFunction.Hide();

                                    if (objRes.result == 0) {
                                        window.location.reload();
                                    } else {
                                        Swal.fire('Gagal Finalisasi!', objRes.message, 'error');
                                    }
                                },
                                error: function(response) {
                                    console.log('response err >> ', response);
                                    LoadingScreenFunction.Hide();
                                    Swal.fire('Error : ' + response.status, response.responseText, 'error');
                                }
                            });
                        }
                    });
                }),
            Finalize: (() => {
                var isValid = 0;
                var noString = $('#noString').val();
                if (noString == '') {
                    isValid += validateBlank('no');
                }

                if (isValid > 0) {
                    Swal.fire('Fail', 'Please input all mandatory data', 'error');
                    return;
                }

                Swal.fire({
                    title: 'Finalisasi Surat Jalan?',
                    text: "Data tidak dapat diubah lagi!",
                    icon: 'success',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Ya, Finalisasi!',
                    cancelButtonText: 'Selesai'
                }).then((result) => {
                    if (result.isConfirmed) {
                        LoadingScreenFunction.Show();

                        $.ajax({
                            type: "POST",
                            url: "/SuratJalanP1s/Update?Handler=Finalize",
                            data: {
                                suratJalanP1Id: $('#suratJalanP1Id').val(),
                                type: $('#type').val(),
                                no: $('#no').val(),
                                sequence: $('#sequence').val()
                            },
                            headers: {
                                'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                            },
                            success: function(objRes) {
                                console.log('objRes >> ', objRes);
                                LoadingScreenFunction.Hide();

                                if (objRes.result == 0) {
                                    window.location.reload();
                                } else {
                                    Swal.fire('Gagal Finalisasi!', objRes.message, 'error');
                                }
                            },
                            error: function(response) {
                                console.log('response err >> ', response);
                                LoadingScreenFunction.Hide();
                                Swal.fire('Error : ' + response.status, response.responseText, 'error');
                            }
                        });
                    }
                });
                }),
                    Confirm: (() => {
                         Swal.fire({
                            title: 'Konfirmasi Pengiriman?',
                            text: "Data tidak dapat diubah lagi!",
                            icon: 'success',
                            showCancelButton: true,
                            confirmButtonColor: '#3085d6',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'Ya, Konfirmasi!',
                            cancelButtonText: 'Selesai'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                LoadingScreenFunction.Show();

                                $.ajax({
                                    type: "POST",
                                    url: "/SuratJalanP1s/Update?Handler=Confirm",
                                    data: {
                                        suratJalanP1Id: $('#suratJalanP1Id').val()
                                    },
                                    headers: {
                                        'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                                    },
                                    success: function(objRes) {
                                        console.log('objRes >> ', objRes);
                                        LoadingScreenFunction.Hide();

                                        if (objRes.result == 0) {
                                            window.location.reload();
                                        } else {
                                            Swal.fire('Gagal Konfirmasi!', objRes.message, 'error');
                                        }
                                    },
                                    error: function(response) {
                                        console.log('response err >> ', response);
                                        LoadingScreenFunction.Hide();
                                        Swal.fire('Error : ' + response.status, response.responseText, 'error');
                                    }
                                });
                            }
                        });
                    }),
            AddItems: (() => {
                var itemIds = [];
                $(".checkbox-input:checked").each(function() {
                    itemIds.push($(this).val());
                });

                LoadingScreenFunction.Show();

                var dataParam = {
                    itemIds: itemIds,
                    suratJalanP1Id: $('#suratJalanP1Id').val()
                };

                $.ajax({
                    type: "POST",
                    url: "/SuratJalanP1s/Update?Handler=AddItems",
                    data: dataParam,
                    headers: {
                        'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                    },
                    success: function(objRes) {
                        LoadingScreenFunction.Hide();
                        $('#modal').modal('hide');
                        SimplePageTable.GetTable().ajax.reload();
                    },
                    error: function(response) {
                        console.log('response err >> ', response);
                        LoadingScreenFunction.Hide();
                        Swal.fire('Error : ' + response.status, response.responseText, 'error');
                    }
                });
            }),

            RefreshTable: (() => {
                if (_gridModal == null) {
                    _gridModal = $('#gridModal').DataTable({
                        processing: true,
                        serverSide: true,
                        orderCellsTop: true,
                        autoWidth: true,
                        scrollX: true,
                        ajax: {
                            url: _url + '?Handler=RefreshDataModal',
                            type: 'POST',
                            headers: {
                                'RequestVerificationToken': _token
                            },
                            data: function(d) {
                                d.suratJalanP1Id = $('#suratJalanP1Id').val();
                            }
                        },
                        columns: [
                            {
                                data: null,
                                render: function(data, type, row, node) {
                                    return `<input class="form-check-input checkbox-input ms-3" type="checkbox" value="${data['id']}" id="cbInput" checked>`;
                                }
                            },
                            { data: 'createdDateString', name: 'CreatedDate' },
                                { data: 'locationName', name: 'LocationName' },
                                { data: 'id', name: 'Id' },
                            { data: 'merk', name: 'Merk' },
                            { data: 'kp', name: 'Kp' },
                            { data: 'kode1', name: 'Kode1' },
                            { data: 'kode2', name: 'Kode2' },
                            { data: 'kode3', name: 'Kode3' },
                            { data: 'kode4', name: 'Kode4' },
                            { data: 'oz', name: 'Oz' },
                            { data: 'grade', name: 'Grade' },
                            { data: 'point', name: 'Point' },
                            { data: 'yard', name: 'Yard' },
                            { data: 'kg', name: 'Kg' },
                            { data: 'lebar', name: 'Lebar' },
                            { data: 'k', name: 'K' },
                            { data: 'susutLusi', name: 'SusutLusi' },
                            { data: 'serialNumber', name: 'SerialNumber' },
                            { data: 'k3l', name: 'K3l' },
                            { data: 'inisial', name: 'Inisial' },
                            { data: 'tanggalBuatBarcodeString', name: 'TanggalBuatBarcode' }
                        ],
                        order: [[1, "asc"]],
                        columnDefs: [{
                            orderable: false,
                            targets: 0
                        }],
                        pageLength: 25
                    });
                } else {
                    _gridModal.ajax.reload(null, false);
                }
            }) 
        }
    })();
    </script>
    <script>
        var hasDelete = @(Model.ViewModel.FinalizeDate == null && _user.HasReadAccess(AccessMenu.CreateOutbond) ? "true" : "false");
        SimplePageTable.Init($('@Html.AntiForgeryToken()').val(), '/SuratJalanP1s/Update');
        SimplePageTable.InitTable({
        hasAction: hasDelete,
        hasDelete: hasDelete,
        action: 'page',
        columns: [
        { data: null, render: function(data,type,row,node) {
            var html = "<input class=\"form-check-input dt-checkbox-input\" type=\"checkbox\" value=" + data['id'] + " id=\"cbInput\" style=\"margin-left:4px;\">";
            return html;
        }},
        { data: 'createdDateString', name: 'CreatedDate' },
        { data: 'locationName', name: 'LocationName' },
        { data: 'id', name: 'Id' },
        { data: 'merk', name: 'Merk' },
        { data: 'kp', name: 'Kp' },
        { data: 'kode1', name: 'Kode1' },
        { data: 'kode2', name: 'Kode2' },
        { data: 'kode3', name: 'Kode3' },
        { data: 'kode4', name: 'Kode4' },
        { data: 'oz', name: 'Oz' },
        { data: 'grade', name: 'Grade' },
        { data: 'point', name: 'Point' },
        { data: 'yard', name: 'Yard' },
        { data: 'kg', name: 'Kg' },
        { data: 'lebar', name: 'Lebar' },
        { data: 'k', name: 'K' },
        { data: 'susutLusi', name: 'SusutLusi' },
        { data: 'serialNumber', name: 'SerialNumber' },
        { data: 'k3l', name: 'K3l' },
        { data: 'inisial', name: 'Inisial' },
        { data: 'tanggalBuatBarcodeString', name: 'TanggalBuatBarcode' },
        ],
        columnDefs: [
        { targets: [0,1], sortable: false }
        ],
        order: [[3,'desc']]
        });

        jsFunction.Init($('@Html.AntiForgeryToken()').val(), '/SuratJalanP1s/Update');


        let seqPrefix;

        $(document).ready(function () {
            $(".checkbox-input-all").change(function () {
                $(".checkbox-input").prop('checked', $(this).prop("checked"));
            });

            $('#type').change(function () {
                var selectedValue = $('#type').val();
                $('#noPrefixLabel').text(selectedValue + '/');

                var no = $('#no').val();
                if (no.length >= 2) {
                    refreshSequenceNo();
                }
            });

            $('#no').on('input', function() {
                var no = $('#no').val();
                if (no.length >= 2) {
                    var newSeqPrefix = no.substring(0, 2);
                    if (seqPrefix != newSeqPrefix) {
                        seqPrefix = newSeqPrefix;
                        refreshSequenceNo();
                    }
                    if (no.length == 4) {
                        $('#btnFinalize').removeAttr('disabled');
                    } else {
                        $('#btnFinalize').attr('disabled',true);
                    }
                } else {
                    seqPrefix = '';
                    $('#btnFinalize').attr('disabled',true);
                    $('#noPostfixLoading').hide();
                    $('#noPostfixLabel').text('/00001');
                    $('#sequence').val('1');
                }
            });
        });

        function refreshSequenceNo() {
            $('#noPostfixLoading').show();
            $('#noPostfixLabel').text('');
            $.ajax({
                type: "POST",
                url: "/SuratJalanP1s/Update?Handler=GetNoSequence",
                data: {
                    type: $('#type').val(),
                    seqPrefix: seqPrefix
                },
                headers: {
                    'RequestVerificationToken': $('@Html.AntiForgeryToken()').val()
                },
                success: function(objRes) {
                    if (objRes.result == 0) {
                        var no = objRes.data;
                        $('#sequence').val(no);
                        var padded = no.toString().padStart(5,'0');
                        $('#noPostfixLabel').text('/' + padded);
                        $('#noPostfixLoading').hide();
                    }
                },
                error: function(response) {

                }
            })
        }
    </script>
    <script>
        function openAndPrint() {
            // Open a new window
            const printWindow = window.open('', '', 'width=800,height=600');

            // Get the content from the print section
            const content = document.getElementById('print-section').innerHTML;

            // Write content to the new window
            printWindow.document.write('<html><head><title>Invoice</title>');
            printWindow.document.write('<style>body{font-family: Arial, sans-serif;} table{width: 100%; border-collapse: collapse;} th, td{border: 0px solid #ddd; padding: 8px; text-align:center} th{background-color: #f4f4f4;} .cell-wrapper{min-height:20px;display:flex;align-items:center;box-sizing:border-box}</style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(content);

            // Wait for the window to load, then trigger print dialog
            printWindow.document.close();
            printWindow.onload = function() {
                printWindow.print();
                printWindow.close(); // Optionally close the window after printing
            };
        }

    </script>

    <script>

        $('.dt-checkbox-input-all').on('change', function () {
            const isChecked = $(this).is(':checked');
            $('#grid tbody .dt-checkbox-input').prop('checked', isChecked);
            $('#btnUpdateLocation').prop('disabled', !isChecked);
        });

        $(document).on('change', '.dt-checkbox-input', function() {
            const isChecked = $('.dt-checkbox-input:checked').length > 0;
            $('#btnUpdateLocation').prop('disabled', !isChecked);
        });

        SimplePageForm.Init($('@Html.AntiForgeryToken()').val(), '/SuratJalanP1s/Update');
        SimplePageForm.Select2('updateLocationId', 'Pilih Lokasi', 'Select2LocationOutbond', '#modalUpdateLocation');

        function openUpdateLocation() {
            $('#modalUpdateLocation').modal('show');
        }

                function saveUpdateLocation() {
            var ids = []; // Declare the array

            $(".dt-checkbox-input:checked").each(function () {
                ids.push($(this).val());
            });

            if (ids.length > 0) {
                $.ajax({
                    type: 'POST',
                    url: '/SuratJalanP1s/Update?Handler=UpdateLocations',
                    data: {
                        itemIds: ids,
                        newLocationId: $('#updateLocationId').val(), // Fixed here
                        suratJalanId: $('#suratJalanP1Id').val()
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (objRes) {
                        LoadingScreenFunction.Hide();
                        if (objRes.result == 0) {
                            SimplePageTable.GetTable().ajax.reload();
                            $('#modalUpdateLocation').modal('hide');
                        } else {
                            alert(objRes.message);
                        }
                    },
                    error: function (response) { // Changed from 'failed' to 'error'
                        LoadingScreenFunction.Hide();
                        alert('An error occurred while updating locations.');
                    }
                });
            } else {
                alert('Please select at least one item.');
            }
        }
    </script>
}

@section Styles
{
<style>
    /* Hide print section in the browser */
    #print-section {
    display: none;
    }

    @@media print {
    @@page {
    size: landscape;
    }

    body * {
    visibility: hidden;
    }

    #print-section, #print-section * {
    visibility: visible;
    }
    }

    .invoice-box {
    max-width: 600px;
    margin: auto;
    padding: 30px;
    font-family: 'Arial', sans-serif;
    border: 1px solid #eee;
    font-size: 14px;
    }

    .invoice-box table {
    width: 100%;
    border-collapse: collapse;
    }

    .invoice-box th, .invoice-box td {
    border: 1px solid #ddd;
    padding: 8px;
    }

    .invoice-box th {
    background-color: #f4f4f4;
    }


</style>
    
}

<input type="hidden" id="noString" value="@noString" />
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex flex-sm-row flex-column justify-content-between">
                    <div class="me-auto">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/">Home</a></li>
                                <li class="breadcrumb-item"><a href="/SuratJalanP1s/">Surat Jalan</a></li>
                                <li class="breadcrumb-item active" aria-current="Page">Ubah</li>
                            </ol>
                        </nav>

                        <h3 class="pt-3">@ViewData["Title"]</h3>
                    </div>
                    <div class="align-self-end">
                        @if (Model.ViewModel.FinalizeDate == null)
                        {
                            @if (_user.HasReadAccess(AccessMenu.CreateOutbond))
                            {
                                <button class="btn btn-primary mb-3" onclick="jsFunction.Open()">
                                    <i class="fas fa-plus me-1"></i> Tambah
                                </button>
                                @if (string.IsNullOrEmpty(Model.ViewModel.No))
                                {
                                    <button type="button" class="btn btn-success mb-3" onclick="jsFunction.OpenFinalize()">
                                        <i class="fas fa-check me-1"></i>  Finalisasi
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success mb-3" onclick="jsFunction.Finalize()">
                                        <i class="fas fa-check me-1"></i>  Finalisasi
                                    </button>
                                }
                            }
                        }
                        else if (Model.ViewModel.ConfirmDate == null)
                        {
                            <button class="btn btn-primary mb-3" onclick="openAndPrint()">
                                <i class="fas fa-print me-1"></i>  Print Surat Jalan
                            </button>
                            if (HasConfirmAccess || _user.HasReadAccess(AccessMenu.CreateOutbond))
                            {
                                <button type="button" class="btn btn-warning mb-3" onclick="jsFunction.Unfinalize()">
                                    <i class="fas fa-cross me-1"></i>  Batalkan Finalisasi
                                </button>
                            }
                            if (HasConfirmAccess)
                            {

                                <button type="button" class="btn btn-info mb-3" id="btnUpdateLocation" disabled onclick="openUpdateLocation()">
                                    <i class="fas fa-edit me-1"></i>  Ubah Lokasi
                                </button>
                                <button type="button" class="btn btn-success mb-3" onclick="jsFunction.Confirm()">
                                    <i class="fas fa-check me-1"></i>  Konfirmasi Pengiriman
                                </button>
                            }

                        }

                    </div>
                </div>
            </div>

            <div class="card-body">
                <input type="hidden" id="suratJalanP1Id" value="@Model.ViewModel.Id" class="grid-param" />
                <table id="grid" class="bg-white table table-sm fs--1 mb-0 w-100" width="100%">
                    <thead>
                        <tr>
                            @if (Model.ViewModel.FinalizeDate == null && _user.HasReadAccess(AccessMenu.CreateOutbond))
                            {
                                <th>Action</th>
                            }
                            <th><input class="form-check-input dt-checkbox-input-all" type="checkbox" /></th>
                            <th>Tanggal Pembuatan</th>
                            <th>Lokasi</th>
                            <th>Tag Id</th>
                            <th>Merk</th>
                            <th>KP</th>
                            <th>Kode 1</th>
                            <th>Kode 2</th>
                            <th>Kode 3</th>
                            <th>Kode 4</th>
                            <th>OZ</th>
                            <th>Grade</th>
                            <th>Point</th>
                            <th>Yard</th>
                            <th>KG</th>
                            <th>Lebar</th>
                            <th>K</th>
                            <th>Susut Lusi</th>
                            <th>Serial Number</th>
                            <th>K3L</th>
                            <th>Inisial</th>
                            <th>Tanggal Buat Barcode</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


