                    <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
                        <span class="fas fa-times fs--1"></span>
                    </button>
                </div>
                <div class="modal-body">
                    <table id="gridModal" class="bg-white table table-sm fs--1 mb-0 w-100" width="100%">
                        <thead>
                            <tr>
                                <th class="me-1"><input class="form-check-input checkbox-input-all ms-3" type="checkbox" id="cbInputAll" checked></th>
                                <th>Tanggal Pembuatan</th>
                                <th>Lokasi</th>
                                <th>Tag Id</th>
                                <th>Merk</th>
                                <th>KP</th>
                                <th>Kode 1</th>
                                <th>Kode 2</th>
                                <th>Kode 3</th>
                                <th>Kode 4</th>
                                <th>OZ</th>
                                <th>Grade</th>
                                <th>Point</th>
                                <th>Yard</th>
                                <th>KG</th>
                                <th>Lebar</th>
                                <th>K</th>
                                <th>Susut Lusi</th>
                                <th>Serial Number</th>
                                <th>K3L</th>
                                <th>Inisial</th>
                                <th>Tanggal Buat Barcode</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" type="button" onclick="jsFunction.AddItems()">Tambah</button>
                    <button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="modal fade" id="modalFinalize" tabindex="-1" aria-labelledby="entryModalLabel" aria-hidden="true">
    <form id="entryForm" method="POST">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"></h5>
                    <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
                        <span class="fas fa-times fs--1"></span>
                    </button>
                </div>
                <div class="modal-body">

                    <div class="form-group mb-3">
                        <label class="form-label" for="name">Tipe Surat Jalan</label>
                        <select class="form-select modal-input" id="type" name="type">
                            @foreach (var item in Model.SuratJalanTypes)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label" for="no">Nomor Surat Jalan</label>
                        <div class="input-group mb-3">
                             <span class="input-group-text" id="noPrefixLabel">@(Model.SuratJalanTypes.Count > 0 ? Model.SuratJalanTypes[0] : "")/</span>
                            <input class="form-control modal-input" id="no" name="no" type="text" style="max-width:100px" placeholder="cth: OL01" maxlength="4" />
                            <span class="input-group-text d-flex justify-content-center align-items-center" style="width:100px">
                                <span id="noPostfixLabel">/00001</span>
                                <div class="spinner-grow spinner-grow-sm text-secondary" role="status" style="display:none" id="noPostfixLoading">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </span>

                            <input type="hidden" class="modal-input" id="sequence" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btnFinalize" disabled class="btn btn-primary" type="button" onclick="jsFunction.Finalize()">Finalisasi</button>
                    <button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </form>
</div>


<div class="modal fade" id="modalUpdateLocation" tabindex="-1" aria-labelledby="entryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Import</h5>
                <button class="btn p-1" type="button" data-bs-dismiss="modal" aria-label="Close">
                    <span class="fas fa-times fs--1"></span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group mb-3 col-sm-12 col-md-12">
                    <label class="form-label" for="updateLocationId">Lokasi</label>
                    <select class="form-control" id="updateLocationId" name="updateLocationId" required>
                    </select>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <div>
                    <button class="btn btn-primary me-1" type="button" onclick="saveUpdateLocation()">Ubah Lokasi</button>
                    <button class="btn btn-outline-primary" type="button" data-bs-dismiss="modal">Batal</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Static print content (hidden in browser) -->
