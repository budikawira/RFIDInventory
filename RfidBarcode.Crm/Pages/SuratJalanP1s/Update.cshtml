            .table-bordered {
                border: 1px solid black;
                border-collapse: collapse;
                width: 100%;
            }

                .table-bordered th,
                .table-bordered td {
                    border: 1px solid black;
                    padding: 6px;
                    text-align: center;
                }

            /* Borderless table */
            .table-borderless {
                border: none;
                border-collapse: collapse;
                width: 100%;
